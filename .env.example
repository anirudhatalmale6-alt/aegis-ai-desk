# AEGIS AI Desk — environment configuration
# Copy to `.env` (which is git-ignored) and fill in. NEVER commit real secrets.

# ---- LLM (Anthropic Claude) ----
# Your enterprise Anthropic key. Set this and AEGIS routes reasoning to Claude
# automatically — no code change. Leave unset to run the built-in local reasoner.
ANTHROPIC_API_KEY=

# Model to use (see claude docs for current ids). Recommended for reasoning:
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Server ----
PORT=3000

# ---- Per-site webhook secrets ----
# Each of your sites gets its own shared secret used to sign/verify webhooks
# (HMAC-SHA256). Format: SITE_SECRET__<site_id>=<secret>
# Example:
# SITE_SECRET__store-eu=please_generate_a_long_random_secret
# SITE_SECRET__store-us=please_generate_a_long_random_secret
